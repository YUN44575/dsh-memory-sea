{
  "name": "dsh-memory-sea",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "让 AI 记得你说过什么：把会话变成可检索的真实原话，回答前先查、不凭印象编。附带一张星图，想自己翻的时候能看。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "memory-management",
    "visualization",
    "star-map",
    "local-first"
  ],
  "exports": {
    ".": "./dsh-plugin-sea/index.js",
    "./client": "./dsh-plugin-sea/client.js",
    "./locale/*.json": "./dsh-plugin-sea/locale/*.json",
    "./icon": "./dsh-plugin-sea/icon.svg"
  },
  "files": [
    "dsh-plugin-sea/index.js",
    "dsh-plugin-sea/client.js",
    "dsh-plugin-sea/search.js",
    "dsh-plugin-sea/locale/*.json",
    "dsh-plugin-sea/icon.svg",
    "cordis.patch.yml",
    "sea-build/*.mjs",
    "sea-build/*.json",
    "sea-build/src/**/*",
    "sea-build/out/index.html",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/**/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*"
  }
}
