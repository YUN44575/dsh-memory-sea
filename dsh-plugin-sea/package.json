{
  "name": "@local/dsh-plugin-sea",
  "version": "1.0.0",
  "description": "让 AI 记得你说过什么：把会话变成可检索的真实原话，回答前先查、不凭印象编。附带一张星图，想自己翻的时候能看。",
  "private": true,
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "visualization"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "search.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
